# Secret bootstrap untuk endpoint buyer. Hanya dipakai saat settings.app_secret
# di data/db.json masih kosong. Setelah rotasi dari panel, nilai ini diabaikan.
APP_SECRET=

# Wajib. String acak 64 hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=production

# 1 = percayai satu hop reverse proxy (Railway/Render/nginx). 0 = matikan.
TRUST_PROXY=1

# Lokasi data/db.json + data/scripts. Di Railway/Render arahkan ke volume: /data
DATA_DIR=./data

# Opsional (Railway/Render): otomatis buat akun admin saat pertama kali start
# jika db.json belum punya admin (minimal 10 karakter).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
