# Secret bootstrap untuk endpoint buyer. Hanya dipakai saat settings.app_secret
# di data/db.json masih kosong. Setelah rotasi dari panel, nilai ini diabaikan.
APP_SECRET=

# Opsional. Jika dikosongkan, otomatis dibuat dan disimpan di data/db.json.
SESSION_SECRET=

PORT=3000
NODE_ENV=production

# 1 = percayai satu hop reverse proxy (Railway/Render/nginx). 0 = matikan.
TRUST_PROXY=1

# Jendela migrasi: 1 = terima request plaintext ?uid= dari loader lama selama
# X-App-Secret global cocok. Default 0. Nyalakan hanya saat mengedarkan loader
# baru, lalu matikan lagi setelah semua buyer pindah.
LEGACY_PLAINTEXT=0

# Lokasi data/db.json + data/scripts. Di Railway/Render arahkan ke volume: /data
DATA_DIR=./data

# Opsional: otomatis buat akun admin saat start (minimal 6 karakter).
# Jika dikosongkan, halaman /setup otomatis muncul di browser saat pertama kali dibuka.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opsional: Bot Discord bawaan (cukup isi token ini di env; Role ID, Prefix, dll diatur dari menu Bot Discord di web)
DISCORD_BOT_TOKEN=
