<aside class="sidebar" id="app-sidebar" aria-label="Navigasi panel">
  <div class="sidebar-head">
    <a class="brand" href="/admin">
      <span class="brand-mark" aria-hidden="true">LU</span>
      <span>Lisensi UID</span>
      <span class="brand-tag">CGT</span>
    </a>
    <button type="button" class="icon-btn sidebar-close" data-sidebar-toggle aria-label="Tutup navigasi">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="sidebar-scroll">
    <div class="nav-group">
      <span class="nav-group-label">Lisensi</span>
      <nav class="nav" aria-label="Menu utama">
        <a href="/admin" class="nav-item <%= active === 'dashboard' ? 'is-active' : '' %>" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span>Whitelist UID</span>
        </a>
        <% if (!admin || admin.role !== 'leader') { %>
        <a href="/admin/scripts" class="nav-item <%= active === 'scripts' ? 'is-active' : '' %>" <%= active === 'scripts' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
          <span>Scripts Lua</span>
        </a>
        <% } %>
        <a href="/admin/tokens" class="nav-item <%= active === 'tokens' ? 'is-active' : '' %>" <%= active === 'tokens' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
          </svg>
          <span>Token Buyer</span>
        </a>
        <a href="/admin/logs" class="nav-item <%= active === 'logs' ? 'is-active' : '' %>" <%= active === 'logs' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <span>Log Aktivitas</span>
        </a>
      </nav>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Perkakas</span>
      <nav class="nav" aria-label="Menu sistem">
        <button type="button" class="nav-item" data-open-modal="modal-loader-gen">
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <span>Generator Loader</span>
        </button>
        <% if (!admin || admin.role !== 'leader') { %>
        <button type="button" class="nav-item" data-open-modal="modal-universal-backup">
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Backup / Migrasi</span>
        </button>
        <a href="/admin/users" class="nav-item <%= active === 'users' ? 'is-active' : '' %>" <%= active === 'users' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span>Kelola Tim</span>
        </a>
        <a href="/admin/secret" class="nav-item <%= active === 'secret' ? 'is-active' : '' %>" <%= active === 'secret' ? 'aria-current="page"' : '' %>>
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Legacy Secret</span>
          <span class="nav-pill">Old</span>
        </a>
        <% } %>
      </nav>
    </div>

    <div class="sidebar-endpoint">
      <div class="sidebar-endpoint-head">
        <span class="status-dot"></span>
        <span>Endpoint Aktif</span>
      </div>
      <code class="sidebar-endpoint-code">GET /api/verify</code>
    </div>
  </div>

  <div class="sidebar-foot">
    <div class="admin-profile">
      <div class="admin-avatar" aria-hidden="true"><%= (admin && admin.username ? admin.username.slice(0, 1) : 'A').toUpperCase() %></div>
      <div class="admin-meta">
        <span class="admin-name"><%= admin ? admin.username : 'admin' %></span>
        <span class="admin-role"><%= admin && admin.role === 'leader' ? 'Leader' : 'Admin' %></span>
      </div>
    </div>
    <form method="post" action="/logout">
      <button class="btn-icon-only" type="submit" title="Logout" aria-label="Logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </button>
    </form>
  </div>
</aside>

<div class="sidebar-backdrop" data-sidebar-toggle hidden></div>

<header class="mobile-topbar">
  <button type="button" class="icon-btn" data-sidebar-toggle aria-label="Buka menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
  <a class="brand" href="/admin">
    <span class="brand-mark" aria-hidden="true">LU</span>
    <span>Lisensi UID</span>
  </a>
  <button type="button" class="btn btn-sm" data-open-modal="modal-loader-gen">Loader</button>
</header>
