<%- include('partials/head', { title: title }) %>
<div class="app-shell">
  <%- include('partials/nav', { admin: admin, active: 'secret' }) %>

  <main class="main-content">
    <%- include('partials/banner', { msg: msg, err: err }) %>

    <header class="page-bar">
      <div class="page-bar-title">
        <h1>Legacy Secret (X-App-Secret)</h1>
        <p class="page-bar-sub">Kredensial global lama untuk kompatibilitas mundur. Gunakan <a href="/admin/tokens">Token Buyer</a> untuk lisensi per-buyer.</p>
      </div>
      <div class="page-bar-actions">
        <span class="chip">Sumber: <%= fromEnv ? '.env' : 'db.json' %></span>
      </div>
    </header>

    <div class="banner banner-warn">
      <div class="banner-body">
        Secret global bersifat statis dan tidak mengunci UID. Disarankan menggunakan <strong>Token Buyer</strong> untuk distribusi publik.
      </div>
    </div>

    <section class="panel panel-pad form">
      <div class="field-group">
        <label class="field-label" for="secret-value">Nilai X-App-Secret Aktif</label>
        <div class="copy-box">
          <input id="secret-value" type="text" value="<%= secret %>" readonly>
          <button type="button" class="btn" data-copy="<%= secret %>">Salin Secret</button>
        </div>
      </div>

      <form method="post" action="/admin/secret/rotate"
            data-confirm="Rotasi secret global sekarang? Semua loader warisan yang memakai secret lama akan ditolak."
            data-confirm-title="Rotasi Global Secret">
        <div class="form-actions">
          <button class="btn btn-danger" type="submit">Rotasi Secret Baru</button>
        </div>
      </form>
    </section>
  </main>
</div>
<%- include('partials/foot') %>
