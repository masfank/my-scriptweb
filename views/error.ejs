<%- include('partials/head', { title: title }) %>
<main class="auth-shell">
  <div class="auth-card">
    <div class="auth-head">
      <span class="chip">HTTP <%= status %></span>
      <h1><%= status === 404 ? 'Halaman Tidak Ditemukan' : 'Kesalahan Server' %></h1>
      <p><%= message %></p>
    </div>
    <a class="btn btn-primary btn-block" href="/admin">← Kembali ke Panel</a>
  </div>
</main>
<script src="/js/admin.js?v=<%= adminJsVersion %>" defer></script>
</body>
</html>
